// Sumber resource Snapoff: ikon merek + blok versi untuk exe.
// Dikompilasi rc.exe (Windows SDK) -> snapoff.res, lalu csc /win32res:snapoff.res.
// Tanpa SDK, build.cmd jatuh ke /win32icon:app.ico: ikon tetap ada, blok versi tidak.

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 0,9,1,0
PRODUCTVERSION 0,9,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Snapoff - tangkap layar dan anotasi, 100% offline"
            VALUE "FileVersion", "0.9.1.0"
            VALUE "InternalName", "Snapoff"
            VALUE "OriginalFilename", "Snapoff.exe"
            VALUE "ProductName", "Snapoff"
            VALUE "ProductVersion", "0.9.1.0"
            VALUE "Comments", "Tanpa jaringan, tanpa registry, tanpa telemetri, tanpa akun."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END